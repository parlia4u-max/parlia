generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PermissionLevel {
  None
  View
  Edit
}

enum PermissionScope {
  Own
  Team
  Firm
}

enum MatterStatus {
  Active
  OnHold
  Closed
}

enum TaskStatus {
  Open
  Complete
}

enum PhysicalFileStatus {
  InStorage
  OutOfStorage
  Closed
}

enum MatterStageKind {
  A
  W
  C
  X
}

enum LeaveType {
  Annual
  Sick
  Study
  FamilyResponsibility
}

enum LeaveRequestStatus {
  Pending
  Approved
  Declined
}

enum AttendanceEventType {
  ClockIn
  LunchStart
  LunchEnd
  ClockOut
  DutyCheckIn
  DutyCheckOut
}

enum ClientDocumentStatus {
  PendingReview
  Accepted
  Rejected
}

enum ClientPortalChallengePurpose {
  Login
  PasswordReset
}

enum IntegrationProvider {
  GoogleCalendar
  Microsoft365Calendar
}

model Firm {
  id              String           @id @default(cuid())
  name            String
  staffSeatLimit  Int?
  createdAt       DateTime         @default(now())
  users           User[]
  roles           Role[]
  invites         Invitation[]
  auditLogs       AuditLog[]
  rolePermissions RolePermission[]
  supervisorLinks SupervisorLink[]
  sessions        Session[]
  loginChallenges LoginChallenge[]
  passwordResets  PasswordReset[]
  setupConfiguration SetupConfiguration?
  matters         Matter[]
  tasks           Task[]
  matterNotes     MatterNote[]
  matterActivities MatterActivity[]
  documentReferences DocumentReference[]
  taskNudges      TaskNudge[]
  calendarEvents CalendarEvent[]
  serviceRecords ServiceRecord[]
  serviceTraces ServiceTrace[]
  duties DutyRecord[]
  physicalFiles PhysicalFile[]
  teamConversations TeamConversation[]
  teamMessages TeamMessage[]
  conversationMembers TeamConversationMember[]
  meetings TeamMeeting[]
  meetingParticipants TeamMeetingParticipant[]
  meetingActionItems TeamMeetingActionItem[]
  suggestions TeamSuggestion[]
  employeeVotes TeamEmployeeVote[]
  leaveProofTasks LeaveProofTask[]
  leaveRequests LeaveRequest[]
  leaveHandovers LeaveTaskHandover[]
  staffProfiles StaffProfile[]
  hrDocuments HRDocument[]
  equipmentAssets EquipmentAsset[]
  equipmentAssignments EquipmentAssignment[]
  onboardingChecklistItems OnboardingChecklistItem[]
  passwordVaultEntries PasswordVaultEntry[]
  attendanceLocations AttendanceLocation[]
  attendanceDays AttendanceDay[]
  reportSettings FirmReportSettings?
  clientAccounts ClientPortalAccount[]
  clientInvitations ClientPortalInvitation[]
  clientSessions ClientPortalSession[]
  clientChallenges ClientPortalChallenge[]
  clientMatterAccess ClientMatterAccess[]
  clientUpdates ClientPortalUpdate[]
  clientDocumentReferences ClientDocumentReference[]
  integrationConnections IntegrationConnection[]
  integrationOAuthStates IntegrationOAuthState[]
}

model SetupConfiguration {
  id          String   @id @default(cuid())
  firmId      String   @unique
  firm        Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  draft       Json
  published   Json
  version     Int      @default(0)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id                 String           @id @default(cuid())
  firmId             String
  firm               Firm             @relation(fields: [firmId], references: [id], onDelete: Cascade)
  roleId             String?
  role               Role?            @relation(fields: [roleId, firmId], references: [id, firmId], onDelete: NoAction)
  name               String
  email              String
  passwordHash       String
  isOwner            Boolean          @default(false)
  active             Boolean          @default(true)
  verificationSentAt DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  sessions           Session[]
  loginChallenges    LoginChallenge[]
  passwordResets     PasswordReset[]
  auditLogs          AuditLog[]       @relation("AuditActor")
  supervisorLinks    SupervisorLink[] @relation("SupervisedUser")
  supervises         SupervisorLink[] @relation("Supervisor")
  sentInvitations    Invitation[]     @relation("InvitationInviter")
  responsibleMatters Matter[]         @relation("MatterResponsible")
  createdMatters     Matter[]          @relation("MatterCreator")
  assignedTasks      Task[]            @relation("TaskAssignee")
  createdTasks       Task[]            @relation("TaskCreator")
  completedTasks     Task[]            @relation("TaskCompleter")
  matterNotes        MatterNote[]
  matterActivities   MatterActivity[]
  documentReferences DocumentReference[]
  sentTaskNudges     TaskNudge[]       @relation("TaskNudgeSender")
  receivedTaskNudges TaskNudge[]       @relation("TaskNudgeRecipient")
  ownedCalendarEvents CalendarEvent[] @relation("CalendarEventOwner")
  responsibleCalendarEvents CalendarEvent[] @relation("CalendarEventResponsible")
  createdCalendarEvents CalendarEvent[] @relation("CalendarEventCreator")
  calendarEventAttendances CalendarEventAttendee[]
  completedCalendarChecklistItems CalendarEventChecklistItem[] @relation("CalendarChecklistCompleter")
  createdServiceRecords ServiceRecord[] @relation("ServiceRecordCreator")
  createdServiceTraces ServiceTrace[] @relation("ServiceTraceCreator")
  createdDuties DutyRecord[] @relation("DutyCreator")
  assignedDuties DutyRecord[] @relation("DutyAssignee")
  physicalFileCheckouts PhysicalFile[] @relation("PhysicalFileBorrower")
  conversationsCreated TeamConversation[] @relation("ConversationCreator")
  conversationMemberships TeamConversationMember[]
  sentTeamMessages TeamMessage[] @relation("TeamMessageSender")
  createdMeetings TeamMeeting[] @relation("MeetingCreator")
  meetingParticipations TeamMeetingParticipant[]
  meetingActionItemsCreated TeamMeetingActionItem[] @relation("MeetingActionCreator")
  submittedSuggestions TeamSuggestion[] @relation("SuggestionSubmitter")
  employeeVotesCast TeamEmployeeVote[] @relation("EmployeeVoteVoter")
  employeeVotesReceived TeamEmployeeVote[] @relation("EmployeeVoteNominee")
  leaveRequests LeaveRequest[] @relation("LeaveRequester")
  leaveApprovals LeaveRequest[] @relation("LeaveApprover")
  leaveCovers LeaveRequest[] @relation("LeaveCover")
  leaveReturns LeaveRequest[] @relation("LeaveReturner")
  leaveHandoversAsOriginal LeaveTaskHandover[] @relation("LeaveOriginalAssignee")
  leaveHandoversAsCover LeaveTaskHandover[] @relation("LeaveTaskCover")
  staffProfile StaffProfile?
  hrDocuments HRDocument[] @relation("HRDocumentSubject")
  managedEquipment EquipmentAsset[] @relation("EquipmentAssignee")
  equipmentAssignmentHistory EquipmentAssignment[]
  equipmentAssignmentsMade EquipmentAsset[] @relation("EquipmentAssigner")
  equipmentAssignmentActions EquipmentAssignment[] @relation("EquipmentAssignmentAssigner")
  completedOnboardingItems OnboardingChecklistItem[]
  vaultEntriesCreated PasswordVaultEntry[]
  attendanceDays AttendanceDay[]
  clientPortalInvitations ClientPortalInvitation[] @relation("ClientInviteSender")
  clientUpdates ClientPortalUpdate[] @relation("ClientUpdateCreator")
  reviewedClientDocuments ClientDocumentReference[] @relation("ClientDocumentReviewer")
  integrationConnections IntegrationConnection[] @relation("IntegrationConnectedBy")
  integrationOAuthStates IntegrationOAuthState[] @relation("IntegrationOAuthInitiator")

  @@unique([email])
  @@unique([id, firmId])
  @@index([firmId, active])
}

model Role {
  id          String           @id @default(cuid())
  firmId      String
  firm        Firm             @relation(fields: [firmId], references: [id], onDelete: Cascade)
  name        String
  isTemplate  Boolean          @default(false)
  createdAt   DateTime         @default(now())
  users       User[]
  permissions RolePermission[]
  invitations Invitation[]

  @@unique([id, firmId])
  @@unique([firmId, name])
}

model RolePermission {
  id     String          @id @default(cuid())
  firmId String          @map("firm_id")
  firm   Firm            @relation(fields: [firmId], references: [id], onDelete: Cascade)
  roleId String
  role   Role            @relation(fields: [roleId, firmId], references: [id, firmId], onDelete: Cascade)
  module String
  level  PermissionLevel @default(None)
  scope  PermissionScope @default(Own)

  @@unique([roleId, module])
}

model SupervisorLink {
  id           String   @id @default(cuid())
  firmId       String   @map("firm_id")
  firm         Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation("SupervisedUser", fields: [userId, firmId], references: [id, firmId], onDelete: Cascade)
  supervisorId String
  supervisor   User     @relation("Supervisor", fields: [supervisorId, firmId], references: [id, firmId], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([userId])
  @@index([firmId, supervisorId])
}

model Invitation {
  id         String    @id @default(cuid())
  firmId     String
  firm       Firm      @relation(fields: [firmId], references: [id], onDelete: Cascade)
  inviterId  String
  inviter    User      @relation("InvitationInviter", fields: [inviterId, firmId], references: [id, firmId], onDelete: Cascade)
  roleId     String
  role       Role      @relation(fields: [roleId, firmId], references: [id, firmId], onDelete: NoAction)
  email      String
  name       String
  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([firmId, email])
}

model AuditLog {
  id         String   @id @default(cuid())
  firmId     String
  firm       Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId, firmId], references: [id, firmId], onDelete: NoAction)
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([firmId, createdAt])
}

model Session {
  id             String   @id @default(cuid())
  firmId         String   @map("firm_id")
  firm           Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId, firmId], references: [id, firmId], onDelete: Cascade)
  tokenHash      String   @unique
  lastActivityAt DateTime @default(now())
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([firmId, userId, expiresAt])
}

model LoginChallenge {
  id        String   @id @default(cuid())
  firmId    String   @map("firm_id")
  firm      Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId, firmId], references: [id, firmId], onDelete: Cascade)
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([firmId, userId, expiresAt])
}

model PasswordReset {
  id        String   @id @default(cuid())
  firmId    String   @map("firm_id")
  firm      Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId, firmId], references: [id, firmId], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([firmId, userId, expiresAt])
}

model Matter {
  id                String       @id @default(cuid())
  firmId            String
  firm              Firm         @relation(fields: [firmId], references: [id], onDelete: Cascade)
  matterNumber      String
  clientName        String
  clientSurname     String
  clientEmail       String?
  matterType        String
  stage             String
  stageKind         MatterStageKind @default(A)
  responsibleId     String
  responsible       User         @relation("MatterResponsible", fields: [responsibleId, firmId], references: [id, firmId], onDelete: Restrict)
  createdById       String
  createdBy         User         @relation("MatterCreator", fields: [createdById, firmId], references: [id, firmId], onDelete: Restrict)
  clientNumber      String?
  otherReferences   String?
  caseNumber        String?
  status            MatterStatus @default(Active)
  onHoldReason      String?
  reviewDate        DateTime?
  lastActivityAt    DateTime     @default(now())
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  tasks             Task[]
  notes             MatterNote[]
  activities        MatterActivity[]
  documentReferences DocumentReference[]
  calendarEvents    CalendarEvent[]
  serviceRecords    ServiceRecord[]
  duties            DutyRecord[]
  physicalFile      PhysicalFile?
  teamMessages      TeamMessage[]
  meetings          TeamMeeting[]
  clientPortalAccess ClientMatterAccess[]
  clientPortalUpdates ClientPortalUpdate[]
  clientDocumentReferences ClientDocumentReference[]
  clientPortalInvitations ClientPortalInvitation[]

  @@unique([id, firmId])
  @@unique([firmId, matterNumber])
  @@index([firmId, status, lastActivityAt])
  @@index([firmId, responsibleId, status])
  @@index([firmId, matterType, stage])
}

model Task {
  id              String     @id @default(cuid())
  firmId          String
  firm            Firm       @relation(fields: [firmId], references: [id], onDelete: Cascade)
  matterId        String?
  matter          Matter?    @relation(fields: [matterId, firmId], references: [id, firmId], onDelete: Cascade)
  title           String
  category        String
  stage           String?
  assignedToId    String
  assignedTo      User       @relation("TaskAssignee", fields: [assignedToId, firmId], references: [id, firmId], onDelete: Restrict)
  createdById     String
  createdBy       User       @relation("TaskCreator", fields: [createdById, firmId], references: [id, firmId], onDelete: Restrict)
  dueAt           DateTime?
  status          TaskStatus @default(Open)
  completedAt     DateTime?
  completedById   String?
  completedBy     User?      @relation("TaskCompleter", fields: [completedById, firmId], references: [id, firmId], onDelete: NoAction)
  nudges          TaskNudge[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  convertedMessage TeamMessage? @relation("MessageTask")
  meetingActionItem TeamMeetingActionItem?
  leaveHandovers LeaveTaskHandover[]
  leaveProof LeaveProofTask?

  @@unique([id, firmId])
  @@index([firmId, assignedToId, status, dueAt])
  @@index([firmId, matterId, status, dueAt])
}

model MatterNote {
  id        String   @id @default(cuid())
  firmId    String
  firm      Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  matterId  String
  matter    Matter   @relation(fields: [matterId, firmId], references: [id, firmId], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId, firmId], references: [id, firmId], onDelete: Restrict)
  body      String
  createdAt DateTime @default(now())

  @@index([firmId, matterId, createdAt])
}

model MatterActivity {
  id        String   @id @default(cuid())
  firmId    String
  firm      Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  matterId  String
  matter    Matter   @relation(fields: [matterId, firmId], references: [id, firmId], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation(fields: [actorId, firmId], references: [id, firmId], onDelete: NoAction)
  action    String
  details   Json?
  createdAt DateTime @default(now())

  @@index([firmId, matterId, createdAt])
}

model DocumentReference {
  id          String   @id @default(cuid())
  firmId      String
  firm        Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  matterId    String
  matter      Matter   @relation(fields: [matterId, firmId], references: [id, firmId], onDelete: Cascade)
  createdById String
  createdBy   User     @relation(fields: [createdById, firmId], references: [id, firmId], onDelete: Restrict)
  label       String
  reference   String
  createdAt   DateTime @default(now())

  @@index([firmId, matterId, createdAt])
}

model TaskNudge {
  id          String   @id @default(cuid())
  firmId      String
  firm        Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  taskId      String
  task        Task     @relation(fields: [taskId, firmId], references: [id, firmId], onDelete: Cascade)
  senderId    String
  sender      User     @relation("TaskNudgeSender", fields: [senderId, firmId], references: [id, firmId], onDelete: Cascade)
  recipientId String
  recipient   User     @relation("TaskNudgeRecipient", fields: [recipientId, firmId], references: [id, firmId], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([firmId, recipientId, createdAt])
  @@index([firmId, taskId, createdAt])
}

model ServiceRecord {
  id          String   @id @default(cuid())
  firmId      String
  firm        Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  matterId    String
  matter      Matter   @relation(fields: [matterId, firmId], references: [id, firmId], onDelete: Cascade)
  recipient   String
  serviceType String
  status      String   @default("Pending")
  outcome     String?
  serviceDate DateTime?
  details     String?
  createdById String
  createdBy   User     @relation("ServiceRecordCreator", fields: [createdById, firmId], references: [id, firmId], onDelete: Restrict)
  traces      ServiceTrace[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([id, firmId])
  @@index([firmId, status, serviceDate])
  @@index([firmId, matterId, createdAt])
}

model ServiceTrace {
  id          String        @id @default(cuid())
  firmId      String
  firm        Firm          @relation(fields: [firmId], references: [id], onDelete: Cascade)
  serviceId   String
  service     ServiceRecord @relation(fields: [serviceId, firmId], references: [id, firmId], onDelete: Cascade)
  attempt     Int
  attemptedAt DateTime      @default(now())
  note        String
  createdById String
  createdBy   User          @relation("ServiceTraceCreator", fields: [createdById, firmId], references: [id, firmId], onDelete: Restrict)

  @@unique([serviceId, attempt])
  @@index([firmId, serviceId, attemptedAt])
}

model DutyRecord {
  id           String   @id @default(cuid())
  firmId       String
  firm         Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  matterId     String?
  matter       Matter?  @relation(fields: [matterId, firmId], references: [id, firmId], onDelete: Cascade)
  title        String
  method       String
  dueAt        DateTime?
  status       String   @default("Scheduled")
  returnedAt   DateTime?
  returnNotes  String?
  assignedToId String
  assignedTo   User     @relation("DutyAssignee", fields: [assignedToId, firmId], references: [id, firmId], onDelete: Restrict)
  createdById  String
  createdBy    User     @relation("DutyCreator", fields: [createdById, firmId], references: [id, firmId], onDelete: Restrict)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([id, firmId])
  @@index([firmId, status, dueAt])
  @@index([firmId, assignedToId, status, dueAt])
  attendanceEvents AttendanceEvent[]
}

model AttendanceLocation {
  id           String            @id @default(cuid())
  firmId       String
  firm         Firm              @relation(fields: [firmId], references: [id], onDelete: Cascade)
  name         String
  latitude     Float
  longitude    Float
  radiusMeters Int
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  events       AttendanceEvent[]

  @@unique([id, firmId])
  @@unique([firmId, name])
  @@index([firmId, active])
}

model AttendanceDay {
  id        String            @id @default(cuid())
  firmId    String
  firm      Firm              @relation(fields: [firmId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId, firmId], references: [id, firmId], onDelete: Cascade)
  workDate  DateTime          @db.Date
  events    AttendanceEvent[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([id, firmId])
  @@unique([firmId, userId, workDate])
  @@index([firmId, workDate])
}

model AttendanceEvent {
  id               String              @id @default(cuid())
  firmId           String
  dayId            String
  day              AttendanceDay       @relation(fields: [dayId, firmId], references: [id, firmId], onDelete: Cascade)
  type             AttendanceEventType
  occurredAt       DateTime            @default(now())
  locationId       String
  location         AttendanceLocation  @relation(fields: [locationId, firmId], references: [id, firmId], onDelete: Restrict)
  locationName     String
  siteLatitude     Float
  siteLongitude    Float
  radiusMeters     Int
  dutyId           String?
  duty             DutyRecord?         @relation(fields: [dutyId, firmId], references: [id, firmId], onDelete: Restrict)
  latitude         Float
  longitude        Float
  accuracyMeters   Float
  distanceMeters   Float
  createdAt        DateTime            @default(now())

  @@unique([id, firmId])
  @@index([firmId, dayId, occurredAt])
  @@index([firmId, locationId, occurredAt])
  @@index([firmId, dutyId, occurredAt])
}

model FirmReportSettings {
  firmId          String   @id
  firm            Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  quietMatterDays Int      @default(30)
  updatedAt       DateTime @updatedAt
}

model ClientPortalAccount {
  id           String                @id @default(cuid())
  firmId       String
  firm         Firm                  @relation(fields: [firmId], references: [id], onDelete: Cascade)
  email        String
  name         String
  passwordHash String?
  active       Boolean               @default(false)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  sessions     ClientPortalSession[]
  challenges   ClientPortalChallenge[]
  matterAccess ClientMatterAccess[]
  invitations  ClientPortalInvitation[]
  submissions  ClientDocumentReference[]

  @@unique([id, firmId])
  @@unique([firmId, email])
  @@index([firmId, active])
}

model ClientPortalInvitation {
  id          String              @id @default(cuid())
  firmId      String
  firm        Firm                @relation(fields: [firmId], references: [id], onDelete: Cascade)
  matterId    String
  matter      Matter              @relation(fields: [matterId, firmId], references: [id, firmId], onDelete: Cascade)
  senderId    String
  sender      User                @relation("ClientInviteSender", fields: [senderId, firmId], references: [id, firmId], onDelete: Cascade)
  clientId    String?
  client      ClientPortalAccount? @relation(fields: [clientId, firmId], references: [id, firmId], onDelete: Cascade)
  email       String
  name        String
  tokenHash   String              @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime            @default(now())

  @@unique([id, firmId])
  @@index([firmId, email, expiresAt])
}

model ClientPortalSession {
  id              String             @id @default(cuid())
  firmId          String
  firm            Firm               @relation(fields: [firmId], references: [id], onDelete: Cascade)
  clientId        String
  client          ClientPortalAccount @relation(fields: [clientId, firmId], references: [id, firmId], onDelete: Cascade)
  tokenHash       String             @unique
  lastActivityAt  DateTime           @default(now())
  expiresAt       DateTime
  createdAt       DateTime           @default(now())

  @@unique([id, firmId])
  @@index([firmId, clientId, expiresAt])
}

model ClientPortalChallenge {
  id         String             @id @default(cuid())
  firmId     String
  firm       Firm               @relation(fields: [firmId], references: [id], onDelete: Cascade)
  clientId   String
  client     ClientPortalAccount @relation(fields: [clientId, firmId], references: [id, firmId], onDelete: Cascade)
  purpose    ClientPortalChallengePurpose @default(Login)
  codeHash   String
  attempts   Int                @default(0)
  expiresAt  DateTime
  createdAt  DateTime           @default(now())

  @@unique([id, firmId])
  @@index([firmId, clientId, expiresAt])
}

model ClientMatterAccess {
  id        String             @id @default(cuid())
  firmId    String
  firm      Firm               @relation(fields: [firmId], references: [id], onDelete: Cascade)
  clientId  String
  client    ClientPortalAccount @relation(fields: [clientId, firmId], references: [id, firmId], onDelete: Cascade)
  matterId  String
  matter    Matter             @relation(fields: [matterId, firmId], references: [id, firmId], onDelete: Cascade)
  grantedAt DateTime           @default(now())
  revokedAt DateTime?

  @@unique([id, firmId])
  @@unique([firmId, clientId, matterId])
  @@index([firmId, clientId, revokedAt])
  @@index([firmId, matterId, revokedAt])
}

model ClientPortalUpdate {
  id          String    @id @default(cuid())
  firmId      String
  firm        Firm      @relation(fields: [firmId], references: [id], onDelete: Cascade)
  matterId    String
  matter      Matter    @relation(fields: [matterId, firmId], references: [id, firmId], onDelete: Cascade)
  createdById String
  createdBy   User      @relation("ClientUpdateCreator", fields: [createdById, firmId], references: [id, firmId], onDelete: Restrict)
  title       String
  body        String
  sharedAt    DateTime?
  createdAt   DateTime  @default(now())

  @@unique([id, firmId])
  @@index([firmId, matterId, sharedAt, createdAt])
}

model ClientDocumentReference {
  id             String               @id @default(cuid())
  firmId         String
  firm           Firm                 @relation(fields: [firmId], references: [id], onDelete: Cascade)
  matterId       String
  matter         Matter               @relation(fields: [matterId, firmId], references: [id, firmId], onDelete: Cascade)
  clientId       String
  client         ClientPortalAccount  @relation(fields: [clientId, firmId], references: [id, firmId], onDelete: Cascade)
  reviewedById   String?
  reviewedBy     User?                @relation("ClientDocumentReviewer", fields: [reviewedById, firmId], references: [id, firmId], onDelete: NoAction)
  label          String
  referenceUrl   String
  status         ClientDocumentStatus @default(PendingReview)
  reviewNote     String?
  submittedAt    DateTime             @default(now())
  reviewedAt     DateTime?

  @@unique([id, firmId])
  @@index([firmId, matterId, status, submittedAt])
  @@index([firmId, clientId, submittedAt])
}

model IntegrationConnection {
  id                    String              @id @default(cuid())
  firmId                String
  firm                  Firm                @relation(fields: [firmId], references: [id], onDelete: Cascade)
  provider              IntegrationProvider
  connectedEmail        String
  encryptedTokens       String
  tokensIv              String
  tokensAuthTag         String
  scopes                String
  accessTokenExpiresAt  DateTime?
  connectedById         String
  connectedBy           User                @relation("IntegrationConnectedBy", fields: [connectedById, firmId], references: [id, firmId], onDelete: Restrict)
  connectedAt           DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([id, firmId])
  @@unique([firmId, provider])
  @@index([firmId, provider, accessTokenExpiresAt])
}

model IntegrationOAuthState {
  id                       String              @id @default(cuid())
  firmId                   String
  firm                     Firm                @relation(fields: [firmId], references: [id], onDelete: Cascade)
  userId                   String
  user                     User                @relation("IntegrationOAuthInitiator", fields: [userId, firmId], references: [id, firmId], onDelete: Cascade)
  provider                 IntegrationProvider
  stateHash                String              @unique
  encryptedCodeVerifier    String
  verifierIv               String
  verifierAuthTag          String
  expiresAt                DateTime
  usedAt                   DateTime?
  createdAt                DateTime            @default(now())

  @@unique([id, firmId])
  @@index([firmId, userId, expiresAt])
}

model PhysicalFile {
  id               String             @id @default(cuid())
  firmId           String
  firm             Firm               @relation(fields: [firmId], references: [id], onDelete: Cascade)
  matterId         String
  matter           Matter             @relation(fields: [matterId, firmId], references: [id, firmId], onDelete: Cascade)
  location         String
  folder           String
  status           PhysicalFileStatus @default(InStorage)
  borrowerId       String?
  borrower         User?              @relation("PhysicalFileBorrower", fields: [borrowerId, firmId], references: [id, firmId], onDelete: Restrict)
  checkedOutAt     DateTime?
  boxNumber        String?
  dateSent         DateTime?
  storageCompany   String?
  barcodeReference String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([matterId, firmId])
  @@unique([id, firmId])
  @@index([firmId, status, location])
  @@index([firmId, boxNumber, barcodeReference])
}

enum CalendarEventAudience {
  Internal
  Client
}

model CalendarEvent {
  id            String                @id @default(cuid())
  firmId        String
  firm          Firm                  @relation(fields: [firmId], references: [id], onDelete: Cascade)
  ownerId       String
  owner         User                  @relation("CalendarEventOwner", fields: [ownerId, firmId], references: [id, firmId], onDelete: Cascade)
  responsibleId String
  responsible   User                  @relation("CalendarEventResponsible", fields: [responsibleId, firmId], references: [id, firmId], onDelete: Restrict)
  createdById   String
  createdBy     User                  @relation("CalendarEventCreator", fields: [createdById, firmId], references: [id, firmId], onDelete: Restrict)
  matterId      String?
  matter        Matter?               @relation(fields: [matterId, firmId], references: [id, firmId], onDelete: Cascade)
  leaveRequestId String?
  leaveRequest  LeaveRequest?         @relation("LeaveCalendarEvent", fields: [leaveRequestId, firmId], references: [id, firmId], onDelete: Cascade)
  title         String
  description   String?
  startAt       DateTime
  endAt         DateTime
  audience      CalendarEventAudience @default(Internal)
  meetingUrl    String?
  attendees     CalendarEventAttendee[]
  checklist     CalendarEventChecklistItem[]
  documents     CalendarEventDocumentReference[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@unique([id, firmId])
  @@unique([leaveRequestId, firmId])
  @@index([firmId, ownerId, startAt])
  @@index([firmId, startAt, endAt])
  @@index([firmId, matterId, startAt])
}

model CalendarEventAttendee {
  id        String        @id @default(cuid())
  firmId    String
  eventId   String
  event     CalendarEvent @relation(fields: [eventId, firmId], references: [id, firmId], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId, firmId], references: [id, firmId], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([eventId, userId])
  @@index([firmId, userId, eventId])
}

model CalendarEventChecklistItem {
  id           String        @id @default(cuid())
  firmId       String
  eventId      String
  event        CalendarEvent @relation(fields: [eventId, firmId], references: [id, firmId], onDelete: Cascade)
  label        String
  completed    Boolean       @default(false)
  completedById String?
  completedBy  User?         @relation("CalendarChecklistCompleter", fields: [completedById, firmId], references: [id, firmId], onDelete: NoAction)
  completedAt  DateTime?
  createdAt    DateTime      @default(now())

  @@index([firmId, eventId, createdAt])
}

model CalendarEventDocumentReference {
  id        String        @id @default(cuid())
  firmId    String
  eventId   String
  event     CalendarEvent @relation(fields: [eventId, firmId], references: [id, firmId], onDelete: Cascade)
  label     String
  url       String
  createdAt DateTime      @default(now())

  @@index([firmId, eventId, createdAt])
}

model TeamConversation {
  id        String                    @id @default(cuid())
  firmId    String
  firm      Firm                      @relation(fields: [firmId], references: [id], onDelete: Cascade)
  title     String?
  kind      String
  createdById String
  createdBy User                      @relation("ConversationCreator", fields: [createdById, firmId], references: [id, firmId], onDelete: Restrict)
  members   TeamConversationMember[]
  messages  TeamMessage[]
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  @@unique([id, firmId])
  @@index([firmId, updatedAt])
}

model TeamConversationMember {
  id             String           @id @default(cuid())
  firmId         String
  firm           Firm             @relation(fields: [firmId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   TeamConversation @relation(fields: [conversationId, firmId], references: [id, firmId], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId, firmId], references: [id, firmId], onDelete: Cascade)
  createdAt      DateTime         @default(now())

  @@unique([conversationId, userId])
  @@index([firmId, userId, conversationId])
}

model TeamMessage {
  id             String           @id @default(cuid())
  firmId         String
  firm           Firm             @relation(fields: [firmId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   TeamConversation @relation(fields: [conversationId, firmId], references: [id, firmId], onDelete: Cascade)
  senderId       String
  sender         User             @relation("TeamMessageSender", fields: [senderId, firmId], references: [id, firmId], onDelete: Restrict)
  body           String
  matterId       String?
  matter         Matter?          @relation(fields: [matterId, firmId], references: [id, firmId], onDelete: NoAction)
  urgent         Boolean          @default(false)
  taskId         String?
  task           Task?            @relation("MessageTask", fields: [taskId, firmId], references: [id, firmId], onDelete: NoAction)
  createdAt      DateTime         @default(now())

  @@unique([id, firmId])
  @@unique([taskId, firmId])
  @@index([firmId, conversationId, createdAt])
  @@index([firmId, matterId, createdAt])
}

model TeamMeeting {
  id           String                    @id @default(cuid())
  firmId       String
  firm         Firm                      @relation(fields: [firmId], references: [id], onDelete: Cascade)
  title        String
  startsAt     DateTime
  templateName String
  matterId     String?
  matter       Matter?                   @relation(fields: [matterId, firmId], references: [id, firmId], onDelete: NoAction)
  minutes      Json?
  urgent       Boolean                   @default(false)
  createdById  String
  createdBy    User                      @relation("MeetingCreator", fields: [createdById, firmId], references: [id, firmId], onDelete: Restrict)
  participants TeamMeetingParticipant[]
  actionItems  TeamMeetingActionItem[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@unique([id, firmId])
  @@index([firmId, startsAt])
  @@index([firmId, matterId, startsAt])
}

model TeamMeetingParticipant {
  id        String     @id @default(cuid())
  firmId    String
  firm      Firm       @relation(fields: [firmId], references: [id], onDelete: Cascade)
  meetingId String
  meeting   TeamMeeting @relation(fields: [meetingId, firmId], references: [id, firmId], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId, firmId], references: [id, firmId], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@index([firmId, userId, meetingId])
}

model TeamMeetingActionItem {
  id           String      @id @default(cuid())
  firmId       String
  firm         Firm        @relation(fields: [firmId], references: [id], onDelete: Cascade)
  meetingId    String
  meeting      TeamMeeting @relation(fields: [meetingId, firmId], references: [id, firmId], onDelete: Cascade)
  title        String
  assignedToId String
  assignedTo   User        @relation("MeetingActionCreator", fields: [assignedToId, firmId], references: [id, firmId], onDelete: Restrict)
  taskId       String?
  task         Task?       @relation(fields: [taskId, firmId], references: [id, firmId], onDelete: NoAction)
  createdAt    DateTime    @default(now())

  @@unique([id, firmId])
  @@unique([taskId, firmId])
  @@index([firmId, meetingId, createdAt])
}

model TeamSuggestion {
  id          String   @id @default(cuid())
  firmId      String
  firm        Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  submitterId String?
  submitter   User?    @relation("SuggestionSubmitter", fields: [submitterId, firmId], references: [id, firmId], onDelete: NoAction)
  anonymous   Boolean  @default(false)
  category    String
  body        String
  status      String   @default("Open")
  createdAt   DateTime @default(now())

  @@unique([id, firmId])
  @@index([firmId, status, createdAt])
}

model TeamEmployeeVote {
  id        String   @id @default(cuid())
  firmId    String
  firm      Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  period    String
  voterId   String
  voter     User     @relation("EmployeeVoteVoter", fields: [voterId, firmId], references: [id, firmId], onDelete: Cascade)
  nomineeId String
  nominee   User     @relation("EmployeeVoteNominee", fields: [nomineeId, firmId], references: [id, firmId], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([firmId, period, voterId])
  @@index([firmId, period, nomineeId])
}

model LeaveRequest {
  id              String             @id @default(cuid())
  firmId          String
  firm            Firm               @relation(fields: [firmId], references: [id], onDelete: Cascade)
  requesterId     String
  requester       User               @relation("LeaveRequester", fields: [requesterId, firmId], references: [id, firmId], onDelete: Cascade)
  coverId         String?
  cover           User?              @relation("LeaveCover", fields: [coverId, firmId], references: [id, firmId], onDelete: Restrict)
  approvedById    String?
  approvedBy      User?              @relation("LeaveApprover", fields: [approvedById, firmId], references: [id, firmId], onDelete: NoAction)
  returnedById    String?
  returnedBy      User?              @relation("LeaveReturner", fields: [returnedById, firmId], references: [id, firmId], onDelete: NoAction)
  type            LeaveType
  startDate       DateTime           @db.Date
  endDate         DateTime           @db.Date
  requestedDays   Int
  reason          String
  status          LeaveRequestStatus @default(Pending)
  formTemplate    String             @default("A")
  formSnapshot    Json
  decisionNote    String?
  submittedAt     DateTime           @default(now())
  decidedAt       DateTime?
  returnedAt      DateTime?
  handovers       LeaveTaskHandover[]
  proofTask       LeaveProofTask?
  calendarEvent   CalendarEvent?     @relation("LeaveCalendarEvent")

  @@unique([id, firmId])
  @@index([firmId, requesterId, status, startDate])
  @@index([firmId, status, startDate, endDate])
}

model LeaveTaskHandover {
  id                 String       @id @default(cuid())
  firmId             String
  firm               Firm         @relation(fields: [firmId], references: [id], onDelete: Cascade)
  leaveRequestId     String
  leaveRequest       LeaveRequest @relation(fields: [leaveRequestId, firmId], references: [id, firmId], onDelete: Cascade)
  taskId             String
  task               Task         @relation(fields: [taskId, firmId], references: [id, firmId], onDelete: Restrict)
  originalAssigneeId String
  originalAssignee   User         @relation("LeaveOriginalAssignee", fields: [originalAssigneeId, firmId], references: [id, firmId], onDelete: Restrict)
  coverId            String
  cover              User         @relation("LeaveTaskCover", fields: [coverId, firmId], references: [id, firmId], onDelete: Restrict)
  taskSnapshot       Json
  restoredAt         DateTime?

  @@unique([leaveRequestId, taskId])
  @@index([firmId, coverId, restoredAt])
}

model LeaveProofTask {
  id             String       @id @default(cuid())
  firmId         String
  firm           Firm         @relation(fields: [firmId], references: [id], onDelete: Cascade)
  leaveRequestId String       @unique
  leaveRequest   LeaveRequest @relation(fields: [leaveRequestId, firmId], references: [id, firmId], onDelete: Cascade)
  taskId         String       @unique
  task           Task         @relation(fields: [taskId, firmId], references: [id, firmId], onDelete: Cascade)

  @@unique([id, firmId])
  @@unique([leaveRequestId, firmId])
  @@unique([taskId, firmId])
  @@index([firmId, leaveRequestId])
}

model StaffProfile {
  id                  String   @id @default(cuid())
  firmId              String
  firm                Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  userId              String
  user                User     @relation(fields: [userId, firmId], references: [id, firmId], onDelete: Cascade)
  nextOfKinCiphertext String?
  nextOfKinIv         String?
  nextOfKinTag        String?
  employmentStartDate DateTime? @db.Date
  onboardingDueAt     DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  checklist           OnboardingChecklistItem[]

  @@unique([userId, firmId])
  @@unique([id, firmId])
  @@index([firmId, onboardingDueAt])
}

model OnboardingChecklistItem {
  id            String       @id @default(cuid())
  firmId        String
  firm          Firm         @relation(fields: [firmId], references: [id], onDelete: Cascade)
  profileId     String
  profile       StaffProfile @relation(fields: [profileId, firmId], references: [id, firmId], onDelete: Cascade)
  name          String
  required      Boolean      @default(false)
  completed     Boolean      @default(false)
  completedById String?
  completedBy   User?        @relation(fields: [completedById, firmId], references: [id, firmId], onDelete: NoAction)
  completedAt   DateTime?
  updatedAt     DateTime     @updatedAt

  @@unique([profileId, name])
  @@index([firmId, profileId, completed])
}

model HRDocument {
  id                    String   @id @default(cuid())
  firmId                String
  firm                  Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  subjectId             String
  subject               User     @relation("HRDocumentSubject", fields: [subjectId, firmId], references: [id, firmId], onDelete: Cascade)
  documentTypeHash      String
  encryptedMetadata     String
  metadataIv            String
  metadataAuthTag       String
  encryptedContent      String
  contentIv             String
  contentAuthTag        String
  locked                Boolean  @default(true)
  resubmissionRequested Boolean  @default(false)
  submittedAt           DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([subjectId, documentTypeHash])
  @@unique([id, firmId])
  @@index([firmId, subjectId, documentTypeHash])
}

model EquipmentAsset {
  id                String                @id @default(cuid())
  firmId            String
  firm              Firm                  @relation(fields: [firmId], references: [id], onDelete: Cascade)
  name              String
  serialNumber      String
  condition         String
  assignedToId      String?
  assignedTo        User?                 @relation("EquipmentAssignee", fields: [assignedToId, firmId], references: [id, firmId], onDelete: Restrict)
  assignedById      String
  assignedBy        User                  @relation("EquipmentAssigner", fields: [assignedById, firmId], references: [id, firmId], onDelete: Restrict)
  signedDeclaration String
  assignedAt        DateTime?
  returnedAt        DateTime?
  assignments       EquipmentAssignment[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([id, firmId])
  @@unique([firmId, serialNumber])
  @@index([firmId, assignedToId, returnedAt])
}

model EquipmentAssignment {
  id                String         @id @default(cuid())
  firmId            String
  firm              Firm           @relation(fields: [firmId], references: [id], onDelete: Cascade)
  equipmentId       String
  equipment         EquipmentAsset @relation(fields: [equipmentId, firmId], references: [id, firmId], onDelete: Cascade)
  userId            String
  user              User           @relation(fields: [userId, firmId], references: [id, firmId], onDelete: Restrict)
  assignedById      String
  assignedBy        User           @relation("EquipmentAssignmentAssigner", fields: [assignedById, firmId], references: [id, firmId], onDelete: Restrict)
  conditionAtIssue  String
  signedDeclaration String
  assignedAt        DateTime       @default(now())
  returnedAt        DateTime?
  returnCondition   String?

  @@unique([id, firmId])
  @@index([firmId, equipmentId, assignedAt])
  @@index([firmId, userId, returnedAt])
}

model PasswordVaultEntry {
  id                String   @id @default(cuid())
  firmId            String
  firm              Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  encryptedMetadata String
  metadataIv        String
  metadataAuthTag   String
  encryptedSecret   String
  secretIv          String
  secretAuthTag     String
  createdById       String
  createdBy         User     @relation(fields: [createdById, firmId], references: [id, firmId], onDelete: Restrict)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([id, firmId])
  @@index([firmId, createdAt])
}
