generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PermissionLevel {
  None
  View
  Edit
}

enum PermissionScope {
  Own
  Team
  Firm
}

enum MatterStatus {
  Active
  OnHold
  Closed
}

enum TaskStatus {
  Open
  Complete
}

enum PhysicalFileStatus {
  InStorage
  OutOfStorage
  Closed
}

enum MatterStageKind {
  A
  W
  C
  X
}

model Firm {
  id              String           @id @default(cuid())
  name            String
  staffSeatLimit  Int?
  createdAt       DateTime         @default(now())
  users           User[]
  roles           Role[]
  invites         Invitation[]
  auditLogs       AuditLog[]
  rolePermissions RolePermission[]
  supervisorLinks SupervisorLink[]
  sessions        Session[]
  loginChallenges LoginChallenge[]
  passwordResets  PasswordReset[]
  setupConfiguration SetupConfiguration?
  matters         Matter[]
  tasks           Task[]
  matterNotes     MatterNote[]
  matterActivities MatterActivity[]
  documentReferences DocumentReference[]
  taskNudges      TaskNudge[]
  calendarEvents CalendarEvent[]
  serviceRecords ServiceRecord[]
  serviceTraces ServiceTrace[]
  duties DutyRecord[]
  physicalFiles PhysicalFile[]
  teamConversations TeamConversation[]
  teamMessages TeamMessage[]
  conversationMembers TeamConversationMember[]
  meetings TeamMeeting[]
  meetingParticipants TeamMeetingParticipant[]
  meetingActionItems TeamMeetingActionItem[]
  suggestions TeamSuggestion[]
  employeeVotes TeamEmployeeVote[]
}

model SetupConfiguration {
  id          String   @id @default(cuid())
  firmId      String   @unique
  firm        Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  draft       Json
  published   Json
  version     Int      @default(0)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id                 String           @id @default(cuid())
  firmId             String
  firm               Firm             @relation(fields: [firmId], references: [id], onDelete: Cascade)
  roleId             String?
  role               Role?            @relation(fields: [roleId, firmId], references: [id, firmId], onDelete: NoAction)
  name               String
  email              String
  passwordHash       String
  isOwner            Boolean          @default(false)
  active             Boolean          @default(true)
  verificationSentAt DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  sessions           Session[]
  loginChallenges    LoginChallenge[]
  passwordResets     PasswordReset[]
  auditLogs          AuditLog[]       @relation("AuditActor")
  supervisorLinks    SupervisorLink[] @relation("SupervisedUser")
  supervises         SupervisorLink[] @relation("Supervisor")
  sentInvitations    Invitation[]     @relation("InvitationInviter")
  responsibleMatters Matter[]         @relation("MatterResponsible")
  createdMatters     Matter[]          @relation("MatterCreator")
  assignedTasks      Task[]            @relation("TaskAssignee")
  createdTasks       Task[]            @relation("TaskCreator")
  completedTasks     Task[]            @relation("TaskCompleter")
  matterNotes        MatterNote[]
  matterActivities   MatterActivity[]
  documentReferences DocumentReference[]
  sentTaskNudges     TaskNudge[]       @relation("TaskNudgeSender")
  receivedTaskNudges TaskNudge[]       @relation("TaskNudgeRecipient")
  ownedCalendarEvents CalendarEvent[] @relation("CalendarEventOwner")
  responsibleCalendarEvents CalendarEvent[] @relation("CalendarEventResponsible")
  createdCalendarEvents CalendarEvent[] @relation("CalendarEventCreator")
  calendarEventAttendances CalendarEventAttendee[]
  completedCalendarChecklistItems CalendarEventChecklistItem[] @relation("CalendarChecklistCompleter")
  createdServiceRecords ServiceRecord[] @relation("ServiceRecordCreator")
  createdServiceTraces ServiceTrace[] @relation("ServiceTraceCreator")
  createdDuties DutyRecord[] @relation("DutyCreator")
  assignedDuties DutyRecord[] @relation("DutyAssignee")
  physicalFileCheckouts PhysicalFile[] @relation("PhysicalFileBorrower")
  conversationsCreated TeamConversation[] @relation("ConversationCreator")
  conversationMemberships TeamConversationMember[]
  sentTeamMessages TeamMessage[] @relation("TeamMessageSender")
  createdMeetings TeamMeeting[] @relation("MeetingCreator")
  meetingParticipations TeamMeetingParticipant[]
  meetingActionItemsCreated TeamMeetingActionItem[] @relation("MeetingActionCreator")
  submittedSuggestions TeamSuggestion[] @relation("SuggestionSubmitter")
  employeeVotesCast TeamEmployeeVote[] @relation("EmployeeVoteVoter")
  employeeVotesReceived TeamEmployeeVote[] @relation("EmployeeVoteNominee")

  @@unique([email])
  @@unique([id, firmId])
  @@index([firmId, active])
}

model Role {
  id          String           @id @default(cuid())
  firmId      String
  firm        Firm             @relation(fields: [firmId], references: [id], onDelete: Cascade)
  name        String
  isTemplate  Boolean          @default(false)
  createdAt   DateTime         @default(now())
  users       User[]
  permissions RolePermission[]
  invitations Invitation[]

  @@unique([id, firmId])
  @@unique([firmId, name])
}

model RolePermission {
  id     String          @id @default(cuid())
  firmId String          @map("firm_id")
  firm   Firm            @relation(fields: [firmId], references: [id], onDelete: Cascade)
  roleId String
  role   Role            @relation(fields: [roleId, firmId], references: [id, firmId], onDelete: Cascade)
  module String
  level  PermissionLevel @default(None)
  scope  PermissionScope @default(Own)

  @@unique([roleId, module])
}

model SupervisorLink {
  id           String   @id @default(cuid())
  firmId       String   @map("firm_id")
  firm         Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation("SupervisedUser", fields: [userId, firmId], references: [id, firmId], onDelete: Cascade)
  supervisorId String
  supervisor   User     @relation("Supervisor", fields: [supervisorId, firmId], references: [id, firmId], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([userId])
  @@index([firmId, supervisorId])
}

model Invitation {
  id         String    @id @default(cuid())
  firmId     String
  firm       Firm      @relation(fields: [firmId], references: [id], onDelete: Cascade)
  inviterId  String
  inviter    User      @relation("InvitationInviter", fields: [inviterId, firmId], references: [id, firmId], onDelete: Cascade)
  roleId     String
  role       Role      @relation(fields: [roleId, firmId], references: [id, firmId], onDelete: NoAction)
  email      String
  name       String
  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([firmId, email])
}

model AuditLog {
  id         String   @id @default(cuid())
  firmId     String
  firm       Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId, firmId], references: [id, firmId], onDelete: NoAction)
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([firmId, createdAt])
}

model Session {
  id             String   @id @default(cuid())
  firmId         String   @map("firm_id")
  firm           Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId, firmId], references: [id, firmId], onDelete: Cascade)
  tokenHash      String   @unique
  lastActivityAt DateTime @default(now())
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([firmId, userId, expiresAt])
}

model LoginChallenge {
  id        String   @id @default(cuid())
  firmId    String   @map("firm_id")
  firm      Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId, firmId], references: [id, firmId], onDelete: Cascade)
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([firmId, userId, expiresAt])
}

model PasswordReset {
  id        String   @id @default(cuid())
  firmId    String   @map("firm_id")
  firm      Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId, firmId], references: [id, firmId], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([firmId, userId, expiresAt])
}

model Matter {
  id                String       @id @default(cuid())
  firmId            String
  firm              Firm         @relation(fields: [firmId], references: [id], onDelete: Cascade)
  matterNumber      String
  clientName        String
  clientSurname     String
  clientEmail       String?
  matterType        String
  stage             String
  stageKind         MatterStageKind @default(A)
  responsibleId     String
  responsible       User         @relation("MatterResponsible", fields: [responsibleId, firmId], references: [id, firmId], onDelete: Restrict)
  createdById       String
  createdBy         User         @relation("MatterCreator", fields: [createdById, firmId], references: [id, firmId], onDelete: Restrict)
  clientNumber      String?
  otherReferences   String?
  caseNumber        String?
  status            MatterStatus @default(Active)
  onHoldReason      String?
  reviewDate        DateTime?
  lastActivityAt    DateTime     @default(now())
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  tasks             Task[]
  notes             MatterNote[]
  activities        MatterActivity[]
  documentReferences DocumentReference[]
  calendarEvents    CalendarEvent[]
  serviceRecords    ServiceRecord[]
  duties            DutyRecord[]
  physicalFile      PhysicalFile?
  teamMessages      TeamMessage[]
  meetings          TeamMeeting[]

  @@unique([id, firmId])
  @@unique([firmId, matterNumber])
  @@index([firmId, status, lastActivityAt])
  @@index([firmId, responsibleId, status])
  @@index([firmId, matterType, stage])
}

model Task {
  id              String     @id @default(cuid())
  firmId          String
  firm            Firm       @relation(fields: [firmId], references: [id], onDelete: Cascade)
  matterId        String?
  matter          Matter?    @relation(fields: [matterId, firmId], references: [id, firmId], onDelete: Cascade)
  title           String
  category        String
  stage           String?
  assignedToId    String
  assignedTo      User       @relation("TaskAssignee", fields: [assignedToId, firmId], references: [id, firmId], onDelete: Restrict)
  createdById     String
  createdBy       User       @relation("TaskCreator", fields: [createdById, firmId], references: [id, firmId], onDelete: Restrict)
  dueAt           DateTime?
  status          TaskStatus @default(Open)
  completedAt     DateTime?
  completedById   String?
  completedBy     User?      @relation("TaskCompleter", fields: [completedById, firmId], references: [id, firmId], onDelete: NoAction)
  nudges          TaskNudge[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  convertedMessage TeamMessage? @relation("MessageTask")
  meetingActionItem TeamMeetingActionItem?

  @@unique([id, firmId])
  @@index([firmId, assignedToId, status, dueAt])
  @@index([firmId, matterId, status, dueAt])
}

model MatterNote {
  id        String   @id @default(cuid())
  firmId    String
  firm      Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  matterId  String
  matter    Matter   @relation(fields: [matterId, firmId], references: [id, firmId], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId, firmId], references: [id, firmId], onDelete: Restrict)
  body      String
  createdAt DateTime @default(now())

  @@index([firmId, matterId, createdAt])
}

model MatterActivity {
  id        String   @id @default(cuid())
  firmId    String
  firm      Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  matterId  String
  matter    Matter   @relation(fields: [matterId, firmId], references: [id, firmId], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation(fields: [actorId, firmId], references: [id, firmId], onDelete: NoAction)
  action    String
  details   Json?
  createdAt DateTime @default(now())

  @@index([firmId, matterId, createdAt])
}

model DocumentReference {
  id          String   @id @default(cuid())
  firmId      String
  firm        Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  matterId    String
  matter      Matter   @relation(fields: [matterId, firmId], references: [id, firmId], onDelete: Cascade)
  createdById String
  createdBy   User     @relation(fields: [createdById, firmId], references: [id, firmId], onDelete: Restrict)
  label       String
  reference   String
  createdAt   DateTime @default(now())

  @@index([firmId, matterId, createdAt])
}

model TaskNudge {
  id          String   @id @default(cuid())
  firmId      String
  firm        Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  taskId      String
  task        Task     @relation(fields: [taskId, firmId], references: [id, firmId], onDelete: Cascade)
  senderId    String
  sender      User     @relation("TaskNudgeSender", fields: [senderId, firmId], references: [id, firmId], onDelete: Cascade)
  recipientId String
  recipient   User     @relation("TaskNudgeRecipient", fields: [recipientId, firmId], references: [id, firmId], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([firmId, recipientId, createdAt])
  @@index([firmId, taskId, createdAt])
}

model ServiceRecord {
  id          String   @id @default(cuid())
  firmId      String
  firm        Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  matterId    String
  matter      Matter   @relation(fields: [matterId, firmId], references: [id, firmId], onDelete: Cascade)
  recipient   String
  serviceType String
  status      String   @default("Pending")
  outcome     String?
  serviceDate DateTime?
  details     String?
  createdById String
  createdBy   User     @relation("ServiceRecordCreator", fields: [createdById, firmId], references: [id, firmId], onDelete: Restrict)
  traces      ServiceTrace[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([id, firmId])
  @@index([firmId, status, serviceDate])
  @@index([firmId, matterId, createdAt])
}

model ServiceTrace {
  id          String        @id @default(cuid())
  firmId      String
  firm        Firm          @relation(fields: [firmId], references: [id], onDelete: Cascade)
  serviceId   String
  service     ServiceRecord @relation(fields: [serviceId, firmId], references: [id, firmId], onDelete: Cascade)
  attempt     Int
  attemptedAt DateTime      @default(now())
  note        String
  createdById String
  createdBy   User          @relation("ServiceTraceCreator", fields: [createdById, firmId], references: [id, firmId], onDelete: Restrict)

  @@unique([serviceId, attempt])
  @@index([firmId, serviceId, attemptedAt])
}

model DutyRecord {
  id           String   @id @default(cuid())
  firmId       String
  firm         Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  matterId     String?
  matter       Matter?  @relation(fields: [matterId, firmId], references: [id, firmId], onDelete: Cascade)
  title        String
  method       String
  dueAt        DateTime?
  status       String   @default("Scheduled")
  returnedAt   DateTime?
  returnNotes  String?
  assignedToId String
  assignedTo   User     @relation("DutyAssignee", fields: [assignedToId, firmId], references: [id, firmId], onDelete: Restrict)
  createdById  String
  createdBy    User     @relation("DutyCreator", fields: [createdById, firmId], references: [id, firmId], onDelete: Restrict)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([id, firmId])
  @@index([firmId, status, dueAt])
  @@index([firmId, assignedToId, status, dueAt])
}

model PhysicalFile {
  id               String             @id @default(cuid())
  firmId           String
  firm             Firm               @relation(fields: [firmId], references: [id], onDelete: Cascade)
  matterId         String
  matter           Matter             @relation(fields: [matterId, firmId], references: [id, firmId], onDelete: Cascade)
  location         String
  folder           String
  status           PhysicalFileStatus @default(InStorage)
  borrowerId       String?
  borrower         User?              @relation("PhysicalFileBorrower", fields: [borrowerId, firmId], references: [id, firmId], onDelete: Restrict)
  checkedOutAt     DateTime?
  boxNumber        String?
  dateSent         DateTime?
  storageCompany   String?
  barcodeReference String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([matterId, firmId])
  @@unique([id, firmId])
  @@index([firmId, status, location])
  @@index([firmId, boxNumber, barcodeReference])
}

enum CalendarEventAudience {
  Internal
  Client
}

model CalendarEvent {
  id            String                @id @default(cuid())
  firmId        String
  firm          Firm                  @relation(fields: [firmId], references: [id], onDelete: Cascade)
  ownerId       String
  owner         User                  @relation("CalendarEventOwner", fields: [ownerId, firmId], references: [id, firmId], onDelete: Cascade)
  responsibleId String
  responsible   User                  @relation("CalendarEventResponsible", fields: [responsibleId, firmId], references: [id, firmId], onDelete: Restrict)
  createdById   String
  createdBy     User                  @relation("CalendarEventCreator", fields: [createdById, firmId], references: [id, firmId], onDelete: Restrict)
  matterId      String?
  matter        Matter?               @relation(fields: [matterId, firmId], references: [id, firmId], onDelete: Cascade)
  title         String
  description   String?
  startAt       DateTime
  endAt         DateTime
  audience      CalendarEventAudience @default(Internal)
  meetingUrl    String?
  attendees     CalendarEventAttendee[]
  checklist     CalendarEventChecklistItem[]
  documents     CalendarEventDocumentReference[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@unique([id, firmId])
  @@index([firmId, ownerId, startAt])
  @@index([firmId, startAt, endAt])
  @@index([firmId, matterId, startAt])
}

model CalendarEventAttendee {
  id        String        @id @default(cuid())
  firmId    String
  eventId   String
  event     CalendarEvent @relation(fields: [eventId, firmId], references: [id, firmId], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId, firmId], references: [id, firmId], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([eventId, userId])
  @@index([firmId, userId, eventId])
}

model CalendarEventChecklistItem {
  id           String        @id @default(cuid())
  firmId       String
  eventId      String
  event        CalendarEvent @relation(fields: [eventId, firmId], references: [id, firmId], onDelete: Cascade)
  label        String
  completed    Boolean       @default(false)
  completedById String?
  completedBy  User?         @relation("CalendarChecklistCompleter", fields: [completedById, firmId], references: [id, firmId], onDelete: NoAction)
  completedAt  DateTime?
  createdAt    DateTime      @default(now())

  @@index([firmId, eventId, createdAt])
}

model CalendarEventDocumentReference {
  id        String        @id @default(cuid())
  firmId    String
  eventId   String
  event     CalendarEvent @relation(fields: [eventId, firmId], references: [id, firmId], onDelete: Cascade)
  label     String
  url       String
  createdAt DateTime      @default(now())

  @@index([firmId, eventId, createdAt])
}

model TeamConversation {
  id        String                    @id @default(cuid())
  firmId    String
  firm      Firm                      @relation(fields: [firmId], references: [id], onDelete: Cascade)
  title     String?
  kind      String
  createdById String
  createdBy User                      @relation("ConversationCreator", fields: [createdById, firmId], references: [id, firmId], onDelete: Restrict)
  members   TeamConversationMember[]
  messages  TeamMessage[]
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  @@unique([id, firmId])
  @@index([firmId, updatedAt])
}

model TeamConversationMember {
  id             String           @id @default(cuid())
  firmId         String
  firm           Firm             @relation(fields: [firmId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   TeamConversation @relation(fields: [conversationId, firmId], references: [id, firmId], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId, firmId], references: [id, firmId], onDelete: Cascade)
  createdAt      DateTime         @default(now())

  @@unique([conversationId, userId])
  @@index([firmId, userId, conversationId])
}

model TeamMessage {
  id             String           @id @default(cuid())
  firmId         String
  firm           Firm             @relation(fields: [firmId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   TeamConversation @relation(fields: [conversationId, firmId], references: [id, firmId], onDelete: Cascade)
  senderId       String
  sender         User             @relation("TeamMessageSender", fields: [senderId, firmId], references: [id, firmId], onDelete: Restrict)
  body           String
  matterId       String?
  matter         Matter?          @relation(fields: [matterId, firmId], references: [id, firmId], onDelete: NoAction)
  urgent         Boolean          @default(false)
  taskId         String?
  task           Task?            @relation("MessageTask", fields: [taskId, firmId], references: [id, firmId], onDelete: NoAction)
  createdAt      DateTime         @default(now())

  @@unique([id, firmId])
  @@unique([taskId, firmId])
  @@index([firmId, conversationId, createdAt])
  @@index([firmId, matterId, createdAt])
}

model TeamMeeting {
  id           String                    @id @default(cuid())
  firmId       String
  firm         Firm                      @relation(fields: [firmId], references: [id], onDelete: Cascade)
  title        String
  startsAt     DateTime
  templateName String
  matterId     String?
  matter       Matter?                   @relation(fields: [matterId, firmId], references: [id, firmId], onDelete: NoAction)
  minutes      Json?
  urgent       Boolean                   @default(false)
  createdById  String
  createdBy    User                      @relation("MeetingCreator", fields: [createdById, firmId], references: [id, firmId], onDelete: Restrict)
  participants TeamMeetingParticipant[]
  actionItems  TeamMeetingActionItem[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@unique([id, firmId])
  @@index([firmId, startsAt])
  @@index([firmId, matterId, startsAt])
}

model TeamMeetingParticipant {
  id        String     @id @default(cuid())
  firmId    String
  firm      Firm       @relation(fields: [firmId], references: [id], onDelete: Cascade)
  meetingId String
  meeting   TeamMeeting @relation(fields: [meetingId, firmId], references: [id, firmId], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId, firmId], references: [id, firmId], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@index([firmId, userId, meetingId])
}

model TeamMeetingActionItem {
  id           String      @id @default(cuid())
  firmId       String
  firm         Firm        @relation(fields: [firmId], references: [id], onDelete: Cascade)
  meetingId    String
  meeting      TeamMeeting @relation(fields: [meetingId, firmId], references: [id, firmId], onDelete: Cascade)
  title        String
  assignedToId String
  assignedTo   User        @relation("MeetingActionCreator", fields: [assignedToId, firmId], references: [id, firmId], onDelete: Restrict)
  taskId       String?
  task         Task?       @relation(fields: [taskId, firmId], references: [id, firmId], onDelete: NoAction)
  createdAt    DateTime    @default(now())

  @@unique([id, firmId])
  @@unique([taskId, firmId])
  @@index([firmId, meetingId, createdAt])
}

model TeamSuggestion {
  id          String   @id @default(cuid())
  firmId      String
  firm        Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  submitterId String?
  submitter   User?    @relation("SuggestionSubmitter", fields: [submitterId, firmId], references: [id, firmId], onDelete: NoAction)
  anonymous   Boolean  @default(false)
  category    String
  body        String
  status      String   @default("Open")
  createdAt   DateTime @default(now())

  @@unique([id, firmId])
  @@index([firmId, status, createdAt])
}

model TeamEmployeeVote {
  id        String   @id @default(cuid())
  firmId    String
  firm      Firm     @relation(fields: [firmId], references: [id], onDelete: Cascade)
  period    String
  voterId   String
  voter     User     @relation("EmployeeVoteVoter", fields: [voterId, firmId], references: [id, firmId], onDelete: Cascade)
  nomineeId String
  nominee   User     @relation("EmployeeVoteNominee", fields: [nomineeId, firmId], references: [id, firmId], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([firmId, period, voterId])
  @@index([firmId, period, nomineeId])
}
